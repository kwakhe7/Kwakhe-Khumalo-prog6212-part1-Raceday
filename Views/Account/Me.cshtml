@using RACEDAY_P3.Services
@model UserDto
@{
    ViewData["Title"] = "My account";
}

<h1 class="rd-h mb-3">My account</h1>

<div class="card rd-card">
    <div class="card-body">
        <p class="text-muted">
            These details were loaded from the RaceDay API using your session, which shows that login works from end to end.
            This page will be replaced by the full Profile page.
        </p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">@Model.Role</dd>
            <dt class="col-sm-3">Member since</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("d MMMM yyyy")</dd>
        </dl>
    </div>
</div>
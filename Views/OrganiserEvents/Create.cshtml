@model EventFormViewModel
@{
    ViewData["Title"] = "Create event";
}

<div class="rd-page-head">
    <h1 class="rd-h">Create event</h1>
    <p class="text-muted mb-0">Fill in the details. Participants can enter as soon as it is saved.</p>
</div>

<div class="card rd-card">
    <div class="card-body p-4">
        <partial name="_EventForm" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
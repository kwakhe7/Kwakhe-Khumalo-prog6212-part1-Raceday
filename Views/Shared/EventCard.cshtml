@using RACEDAY_P3.Services
@model EventDto

<div class="card rd-event-card h-100">
    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="rd-event-media">
        @if (Model.HasBanner)
        {
            <img src="@Url.Action("Banner", "Images", new { id = Model.EventId })" alt="Banner for @Model.Name" loading="lazy" />
        }
        else
        {
            <div class="rd-event-placeholder rd-type-@Model.EventType.ToLower()"><span>@Model.EventType</span></div>
        }
        <span class="rd-type-pill">@Model.EventType</span>
    </a>
    <div class="card-body d-flex flex-column">
        <h2 class="rd-event-title">
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">@Model.Name</a>
        </h2>
        <p class="text-muted small mb-1">@Model.EventDate.ToString("ddd, d MMM yyyy")</p>
        <p class="text-muted small mb-2">@Model.Venue.Name, @Model.Venue.City</p>
        @if (Model.Categories.Any())
        {
            <p class="small mb-3">
                @foreach (var category in Model.Categories)
                {
                    <span class="badge rd-distance-pill">@category.DistanceKm.ToString("0.##") km</span>
                }
            </p>
        }
        <a class="btn btn-rd mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View details</a>
    </div>
</div>
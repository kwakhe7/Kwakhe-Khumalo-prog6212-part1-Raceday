@model EventFormViewModel
@{
    var actionUrl = Model.IsEdit
        ? Url.Action("Edit", "OrganiserEvents", new { id = Model.Id })!
        : Url.Action("Create", "OrganiserEvents")!;
}

<form method="post" action="@actionUrl" enctype="multipart/form-data" asp-antiforgery="true" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="HasBanner" />

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="150" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4" maxlength="500"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="EventDate" class="form-label"></label>
            <input asp-for="EventDate" type="date" class="form-control"
                   min="@(Model.IsEdit ? null : DateTime.Today.ToString("yyyy-MM-dd"))" />
            <span asp-validation-for="EventDate" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="VenueId" class="form-label"></label>
            <select asp-for="VenueId" class="form-select">
                <option value="">Choose a venue...</option>
                @foreach (var venue in Model.Venues)
                {
                    <option value="@venue.VenueId">@venue.Name, @venue.City</option>
                }
            </select>
            <span asp-validation-for="VenueId" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
            <span asp-validation-for="EventType" class="text-danger"></span>
        </div>
    </div>

    <hr class="my-4" />

    @if (Model.IsEdit)
    {
        <h2 class="rd-h h4">Distances</h2>
        @if (Model.Categories.Any())
        {
            <p>
                @foreach (var category in Model.Categories)
                {
                    <span class="badge rd-distance-pill">@category.Name: @category.DistanceKm.ToString("0.##") km</span>
                }
            </p>
        }
        <p class="text-muted small">The distance of an event is set on its categories.</p>
    }
    else
    {
        <h2 class="rd-h h4">First category</h2>
        <p class="text-muted small">Every event has at least one category. This one carries the event's distance. You can add more later.</p>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" placeholder="For example 10km Individual" maxlength="100" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="MaxParticipants" class="form-label"></label>
                <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                <span asp-validation-for="MaxParticipants" class="text-danger"></span>
            </div>
        </div>
    }

    <hr class="my-4" />

    <h2 class="rd-h h4">Banner image</h2>
    @if (Model.IsEdit && Model.HasBanner)
    {
        <img class="rd-banner-preview mb-3" alt="Current banner"
             src="@Url.Action("Banner", "Images", new { id = Model.Id, v = DateTime.UtcNow.Ticks })" />
        <p class="text-muted small">Choose a new image to replace the current banner.</p>
    }
    <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp"
           data-max-mb="5" data-error="#bannerError" />
    <div class="form-text">JPG, PNG or WebP, up to 5 MB. It is shown on the event page.</div>
    <div id="bannerError" class="text-danger small" role="alert"></div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-rd">@(Model.IsEdit ? "Save changes" : "Create event")</button>
        <a class="btn btn-outline-dark" asp-controller="OrganiserEvents" asp-action="Index">Cancel</a>
    </div>
</form>